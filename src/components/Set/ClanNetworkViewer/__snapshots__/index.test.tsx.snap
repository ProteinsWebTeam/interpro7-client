exports[`<ClanNetworkViewer /> gates a large clan behind a "Visualise it" prompt 1`] = `
<div
  className="vf-stack vf-stack--400"
>
  <Card
    title="Clan Network Viewer"
  >
    <section>
      The selected clan has 
      150
       member entries. Displaying more than 
      100
       nodes in this visualisation can affect the performance of your browser.
      <div
        style={
          {
            "textAlign": "right",
          }
        }
      >
        <ForwardRef
          onClick={[Function]}
        >
          Visualise it
        </ForwardRef>
      </div>
    </section>
  </Card>
</div>
`;

exports[`<ClanNetworkViewer /> renders the network container directly for a small clan 1`] = `
<div
  className="vf-stack vf-stack--400"
>
  <div
    className="clan-network-full-screen"
    id="clanNetworkViewerFullScreen"
  >
    <div
      className="clan-network-controls"
    >
      <DropDownButton
        extraClasses="protvista-menu"
        label="Label Content"
      >
        <Memo(Connect(LabelBy)) />
      </DropDownButton>
      <DropDownButton
        label="Legend"
      >
        <Legend
          links={[]}
        />
      </DropDownButton>
      <SizeSlider
        onChange={[Function]}
        value={1}
      />
      <EditModeToggle
        editMode={false}
        onToggle={[Function]}
      />
      <FullScreenButton
        element="clanNetworkViewerFullScreen"
        tooltip="View the clan network in full screen mode"
      />
    </div>
    <div
      className="clan-network-canvas"
      id="clanNetworkViewerContainer"
    />
  </div>
</div>
`;
